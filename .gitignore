# Dependencies
node_modules/
*/node_modules/

# App state — created at runtime, never source. NOT regenerable, back up separately.
# Holds the auth token, PID files, per-service logs, and WebAuthn credentials.
data/

# The launchd log the LaunchAgent writes to (path also lives under data/, kept here for safety)
*.out.log

# Your machine-specific service definitions (may contain absolute personal paths). Local state,
# like data/. The tracked template is services.example.json — copy it to services.json.
services.json

# macOS cruft
.DS_Store

# Editor
.vscode/
*.swp
